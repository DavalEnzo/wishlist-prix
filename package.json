{
  "name": "wishlist-prix",
  "version": "1.0.0",
  "private": true,
  "description": "Suivi du prix le plus bas des jeux de ma wishlist (PC, PS5, revendeurs de clés) avec alertes Discord. Aucune dépendance à l'exécution.",
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "start": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli.ts",
    "dry-run": "node --env-file-if-exists=.env --disable-warning=ExperimentalWarning src/cli.ts --dry-run",
    "preview": "node --disable-warning=ExperimentalWarning scripts/serve.ts",
    "test": "node --disable-warning=ExperimentalWarning --test test/core.test.ts test/integration.test.ts",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run typecheck && npm test"
  },
  "devDependencies": {
    "@types/node": "24.19.2",
    "typescript": "7.0.2"
  }
}
