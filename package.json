{
  "name": "wishlist-prix",
  "version": "2.0.0",
  "private": true,
  "description": "Site multi-utilisateur de wishlist de jeux : prix le plus bas sur PC, PS5 et chez les revendeurs de clés, alertes sur le site et en message privé Discord.",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "worker": "node src/worker/index.ts",
    "migrate": "node src/scripts/migrate.ts",
    "reset-password": "node src/scripts/reset-password.ts",
    "db:generate": "drizzle-kit generate",
    "typecheck": "tsc --noEmit",
    "test": "node --test --test-concurrency=1 \"test/**/*.test.ts\"",
    "check": "npm run typecheck && npm test"
  },
  "dependencies": {
    "drizzle-orm": "0.45.3",
    "next": "16.3.8",
    "nodemailer": "10.0.15",
    "postgres": "3.4.9",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.5.8",
    "@types/node": "24.19.2",
    "@types/nodemailer": "8.0.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "typescript": "5.9.3"
  }
}
