# Copie ce fichier en .env et remplis-le. Ne le mets jamais sur GitHub.

# --- Obligatoire ---------------------------------------------------------
# Mot de passe de la base de données (choisis-en un long, il ne sert qu'en interne).
POSTGRES_PASSWORD=change-moi-par-un-long-mot-de-passe
# Adresse publique du site, sans / final. Sert aux liens et à Discord.
# Exemple local : http://192.168.1.20:3000   Exemple en ligne : https://wishlist.mondomaine.fr
APP_URL=http://localhost:3000

# --- Inscriptions --------------------------------------------------------
# Si défini, il faut ce code pour créer un compte (email ou Discord). Conseillé si le site est sur Internet.
SIGNUP_CODE=

# --- Discord (facultatif) ------------------------------------------------
# Application créée sur https://discord.com/developers/applications
# Connexion : onglet OAuth2, ajoute la redirection  APP_URL/api/auth/discord/callback
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=
# Messages privés : onglet Bot, "Reset Token". Invite le bot sur ton serveur.
DISCORD_BOT_TOKEN=
# Invitation vers ton serveur : les membres du serveur peuvent recevoir les messages du bot.
DISCORD_INVITE_URL=

# --- Emails (facultatif, pour « mot de passe oublié ») -------------------
# Exemple : smtps://utilisateur:motdepasse@smtp.exemple.fr:465
SMTP_URL=
MAIL_FROM=Wishlist gaming <wishlist@mondomaine.fr>

# --- Divers --------------------------------------------------------------
# Heure du relevé quotidien et fuseau horaire.
DAILY_AT=08:41
TIMEZONE=Europe/Paris
# true derrière un tunnel Cloudflare ou un reverse proxy (adresse réelle des visiteurs pour l'anti-abus).
TRUST_PROXY=false
# Port du site sur la machine.
WEB_PORT=3000
